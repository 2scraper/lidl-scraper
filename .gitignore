# scraper output — large, machine-specific, stale by the time anyone reads it
*.json
*.csv
!sample_output.json
!sample_output.csv
lidl_results.*
*_debug.html
*_debug.png
live_results/
# raw captures and dumps, by KIND of directory rather than one chosen name
live/
out/
output/
run/
runs/
result/
results/
tmp/
scratch/
dump/
dumps/
*.page[0-9]*
# a bare HTML dump at the repo root (the landing page is the one exception)
/*.html
!/landing.html

# python
__pycache__/
*.py[cod]
.pytest_cache/
.fingerprint_cache/
*.egg-info/
dist/
build/
.venv/
.venv-*/
venv/
env/

# node (puppeteer/selenium tooling, if any local scripts are added later)
node_modules/

# editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# secrets
*.log
# every renamed working copy of .env (.env.bak, .env.local, .env.save …)
.env*
!.env.example
*.key
secrets*
